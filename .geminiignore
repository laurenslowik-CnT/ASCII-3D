# .geminiignore — Gemini CLI context exclusion (the CLI uses this file rather
# than .aiexclude, which is the Code Assist IDE extension's file).
#
# The block below is generated from .github/scripts/secret-patterns.txt by
# sync-ignores.mjs. To change it, edit that file and run the script.
# === BEGIN SECURITY FLOOR (generated by sync-ignores.mjs — do not edit) ===
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
*.cert
secrets/
secrets.*
credentials.json
service-account*.json
gha-creds-*.json
application_default_credentials.json
.npmrc.local
# === END SECURITY FLOOR ===
