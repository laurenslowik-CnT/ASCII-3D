/.claude/settings.json              @{{org}}/{{securityTeam}}
/docs/security/                     @{{org}}/{{securityTeam}}
/SECURITY.md                        @{{org}}/{{securityTeam}}
.gitignore                          @{{org}}/{{securityTeam}}
.cursorignore                       @{{org}}/{{securityTeam}}
.codeiumignore                      @{{org}}/{{securityTeam}}
.aiexclude                          @{{org}}/{{securityTeam}}
.geminiignore                       @{{org}}/{{securityTeam}}
.clineignore                        @{{org}}/{{securityTeam}}
.claudeignore                       @{{org}}/{{securityTeam}}
