{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.keystore)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*.cert)",
      "Read(secrets/**)",
      "Read(**/secrets/**)",
      "Read(**/secrets.*)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Read(**/gha-creds-*.json)",
      "Read(**/application_default_credentials.json)",
      "Read(**/.npmrc.local)"
    ]
  }
}
